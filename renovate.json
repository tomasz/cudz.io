{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "Europe/Warsaw",
  "schedule": ["* 5-9 * * 1"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "automergeStrategy": "rebase",
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 5-9 * * 1"]
  },
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"]
  },
  "packageRules": [
    {
      "description": "Bundle all non-major updates into one weekly PR.",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch updates"
    },
    {
      "description": "Give major releases longer to settle.",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Keep mise.toml and packageManager on the same pnpm version.",
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm"
    },
    {
      "description": "@astrojs/check requires TypeScript 6.0.x (see AGENTS.md).",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    },
    {
      "description": "@storybook/addon-vitest requires Vitest 4.1.x (see AGENTS.md).",
      "matchPackageNames": ["vitest", "@vitest/*"],
      "allowedVersions": "<4.2.0"
    }
  ]
}
